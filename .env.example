# Copy this file to .env (which git ignores) and fill in your own key.
# A free key is available at https://aistudio.google.com/apikey
# Never commit .env. LogLens never prints or logs the key.
GEMINI_API_KEY=your-key-here

# Optional: the Gemini model (default: gemini-3.8-flash, free tier).
# LOGLENS_LLM_MODEL=gemini-3.8-flash

# Optional: set to 0 to disable every AI feature (same as --no-ai).
# LOGLENS_AI=1
